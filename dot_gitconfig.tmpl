{{- if eq .machine_type "personal" -}}
[user]
    name = Daniel
    email = daniel.widjaja18@gmail.com

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all
{{- else -}}
# Work machine: no git config managed here.
# Run: git config --global user.name "Your Name" && git config --global user.email "you@work.com"
{{- end }}
