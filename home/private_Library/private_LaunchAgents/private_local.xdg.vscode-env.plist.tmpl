<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.xdg.vscode-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/bin/launchctl setenv VSCODE_PORTABLE "{{ .chezmoi.homeDir }}/.local/share/vscode" && /bin/launchctl setenv VSCODE_CLI_DATA_DIR "{{ .chezmoi.homeDir }}/.local/state/vscode-cli"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>