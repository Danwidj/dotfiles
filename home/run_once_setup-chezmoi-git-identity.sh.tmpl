{{ if eq .machine_type "work" -}}
#!/usr/bin/env bash
# run_once_setup-chezmoi-git-identity.sh.tmpl
# Configures personal git author identity and disables commit signing inside the
# chezmoi source repository on work machines.
#
# Why: on work machines, ~/.config/git is ignored by chezmoi (.chezmoiignore.tmpl)
# because enterprise configuration manages global git settings. Commits inside
# the chezmoi source repository (~/.local/share/chezmoi, which auto-commits and
# auto-pushes) would otherwise inherit work git config (work email and 1Password
# commit signing prompts). This script sets repository-local git config on the
# source repo itself.
#
# Idempotent: sets local git config keys via `git -C <sourceDir> config --local`.

set -euo pipefail

SOURCE_DIR={{ .chezmoi.sourceDir | quote }}

git -C "$SOURCE_DIR" config --local user.name "Daniel"
git -C "$SOURCE_DIR" config --local user.email "daniel.widjaja18@gmail.com"
git -C "$SOURCE_DIR" config --local commit.gpgsign false

echo "Configured personal git identity for chezmoi source repo ($SOURCE_DIR)."
{{ end -}}
