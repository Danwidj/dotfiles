# Theme follows system light/dark mode
theme = dark:TokyoNight,light:TokyoNight Day

# keybinds

keybind = clear
# Window + app management
keybind = super+q=quit
keybind = super+w=close_surface
keybind = super+n=new_window
# copy / paste
keybind = super+c=copy_to_clipboard:plain
keybind = super+v=paste_from_clipboard
# Size management
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+zero=reset_font_size
# Settings
keybind = super+comma=open_config
keybind = super+shift+comma=reload_config
# Search
keybind = super+f=start_search
keybind = super+e=search_selection
keybind = super+shift+f=end_search
keybind = performable:escape=end_search
keybind = super+g=navigate_search:next
keybind = super+shift+g=navigate_search:previous
# Text navigation
keybind = super+backspace=text:\x15
keybind = super+arrow_up=jump_to_prompt:-1
keybind = super+arrow_down=jump_to_prompt:1
keybind = super+arrow_right=text:\x05
keybind = super+arrow_left=text:\x01
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f

# aesthetics
macos-option-as-alt = true
macos-titlebar-style = hidden
window-padding-x = 5
window-padding-y = 0

# typography
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

# Stop pop up when quit application
confirm-close-surface = false

# SSH quality-of-life: correct TERM handling + auto terminfo install on remote hosts
shell-integration-features = ssh-env,ssh-terminfo

# Restore window position/size across restarts (macOS only)
window-save-state = always

# Raise scrollback for long agent sessions (was Ghostty's 10M default)
scrollback-limit = 100000000

# Longer undo window for accidental terminal text edits
undo-timeout = 30s

# Keep padding balanced/centered when the grid doesn't fill the window exactly
window-padding-balance = true

# Hide mouse cursor while typing
mouse-hide-while-typing = true

# Match split-divider color to the TokyoNight accent
split-divider-color = #7aa2f7

# Check for updates but don't auto-install
auto-update = check

# Copy on slect
copy-on-select = clipboard
