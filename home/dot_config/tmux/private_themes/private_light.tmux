# Tokyo Night Day
set -g status-style                "bg=#e1e2e7 fg=#3760bf"
set -g status-left                 "#[fg=#2e7de9,bold]  #S  "
set -g status-right                "#[fg=#848cb5] %H:%M  %d %b "
set -g window-status-current-style "fg=#2e7de9,bold"
set -g window-status-style         "fg=#848cb5"
set -g pane-border-style           "fg=#c4c6d0"
set -g pane-active-border-style    "fg=#2e7de9"
set -g message-style               "bg=#e1e2e7 fg=#2e7de9"
