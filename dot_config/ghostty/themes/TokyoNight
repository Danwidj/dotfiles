# User override for Ghostty's bundled "TokyoNight" theme, which has a stale
# palette (dim bright-colors, wrong selection-background) vs upstream.
# Generated directly from the live tokyonight.nvim colorscheme computation
# (not hand-edited, not copied from a possibly-stale extras file):
#
#   nvim --headless -u NONE \
#     -c "set rtp+=<path-to-tokyonight.nvim>" \
#     -c "lua
#       local tokyonight = require('tokyonight.theme')
#       local colors = tokyonight.setup({ style = 'night', plugins = { all = true } })
#       print(require('tokyonight.extra.ghostty').generate(colors))
#     " -c "qa"
#
# Ghostty resolves a theme *name* from ~/.config/ghostty/themes/ before its
# own bundled copy, so this file is picked up automatically by
# `theme = dark:TokyoNight,...` with no other config change needed.
# Re-run the command above and replace this file if tokyonight.nvim's colors
# ever change upstream.

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#ff899d
palette = 10=#9fe044
palette = 11=#faba4a
palette = 12=#8db0ff
palette = 13=#c7a9ff
palette = 14=#a4daff
palette = 15=#c0caf5

background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
selection-background = #283457
selection-foreground = #c0caf5
