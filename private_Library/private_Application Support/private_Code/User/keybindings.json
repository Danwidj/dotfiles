// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "ctrl+\\",
    "command": "python.execInTerminal-icon"
  },
  {
    "key": "ctrl+enter",
    "command": "workbench.action.chat.runInTerminal",
    "when": "hasChatProvider && inChat"
  },
  {
    "key": "ctrl+enter",
    "command": "-workbench.action.chat.runInTerminal",
    "when": "hasChatProvider && inChat"
  },
  {
    "key": "alt+s",
    "command": "editor.emmet.action.wrapWithAbbreviation"
  },
  {
    "key": "ctrl+cmd+right",
    "command": "-workbench.action.terminal.resizePaneRight",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "ctrl+cmd+left",
    "command": "-workbench.action.terminal.resizePaneLeft",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "ctrl+cmd+down",
    "command": "-workbench.action.terminal.resizePaneDown",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "ctrl+cmd+up",
    "command": "-workbench.action.terminal.resizePaneUp",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "cmd+k right",
    "command": "-workbench.action.moveActiveEditorGroupRight"
  },
  {
    "key": "cmd+/",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "cmd+/",
    "command": "editor.action.blockComment",
    "when": "editorHasSelection && editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+cmd+space shift+cmd+r",
    "command": "workbench.view.extension.thunder-client",
    "when": "viewContainer.workbench.view.extension.thunder-client.enabled"
  },
  {
    "key": "shift+cmd+r",
    "command": "-workbench.view.extension.thunder-client",
    "when": "viewContainer.workbench.view.extension.thunder-client.enabled"
  },
  {
    "key": "ctrl+alt+t",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  }
]
